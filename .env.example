# WARNING: This file may be outdated
# See ./src/env.ts for the up-to-date required environment variables

# PUBLIC_URL=""       # set up this value when deploying on a domain (without trailing slash). default to http://localhost:PORT
# PORT=""             # you can change the server port if you want. default to 3000
# TRUSTED_ORIGINS=""  # comma-separated list of allowed origins. default to http://localhost:3000,3001,3002,5173,5174,5175

DB_HOST=""
DB_PORT="5432"
DB_USER=""
DB_PASS=""
DB_NAME="polinetwork_backend"

REDIS_HOST=""
REDIS_PORT=""
REDIS_USERNAME=""
REDIS_PASSWORD=""

# you generate it with `openssl rand -hex 32` !!! MINIMUM LENGTH = 32 bytes !!!
ENCRYPTION_KEY="" 

# you generate it with `openssl rand -hex 20`
BETTER_AUTH_SECRET=""

# Optional. Omit all three to use the seeded in-memory Azure directory.
# Set all three to connect to Microsoft Graph.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_EMAIL_SENDER="noreply@polinetwork.org"

# Optional. PoliNetwork IdP (see "Authentication" in README.md).
# Set IDP_PUBLIC_URL and OAUTH_BACKEND_RESOURCE_URI to verify IdP access tokens.
# IDP_PUBLIC_URL="https://auth.polinetwork.org"
# IDP_INTERNAL_URL="http://auth-service.auth.svc.cluster.local:3000"
# OAUTH_BACKEND_RESOURCE_URI="https://backend.internal.polinetwork.org"
# Also set these to pull the access snapshot; without them every permission check denies.
# OAUTH_INTERNAL_RESOURCE_URI="https://auth.polinetwork.org/api/internal"
# OAUTH_BACKEND_CLIENT_ID=""
# OAUTH_BACKEND_PRIVATE_JWK=""   # the backend client's private JWK as JSON, with kid and alg
# LEGACY_ANONYMOUS="allow"       # "deny" refuses requests without a token
