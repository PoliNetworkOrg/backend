{
  "name": "backend",
  "version": "0.18.1",
  "description": "PoliNetwork backend server",
  "private": true,
  "keywords": [],
  "author": "PoliNetwork APS",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "bun --watch --no-clear-screen ./src/server.ts | pino-pretty",
    "build": "shx rm -rf dist && bun build ./src/server.ts ./src/collab.ts --production --outdir ./dist --sourcemap=linked --target bun && shx cp -r ./drizzle ./dist/",
    "build:npm": "NODE_ENV=production tsup --config tsup.npm.config.ts",
    "email": "email dev --port 3012 --dir src/emails/templates",
    "start": "bun run ./dist/server.js",
    "worker": "bun ./src/regulations/worker/server.ts",
    "collab": "bun --watch ./src/collab.ts | pino-pretty",
    "regulations:dev": "bun ./scripts/regulations/dev.ts",
    "regulations:seed": "bun ./scripts/regulations/seed.ts",
    "regulations:token": "bun ./scripts/regulations/dev-idp.ts token --sub",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write --unsafe",
    "seed:db": "bun ./scripts/seed-db.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@hocuspocus/provider": "^3.4.4",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@peculiar/x509": "^2.2.0",
    "@react-email/preview-server": "5.2.5",
    "@types/bun": "^1.3.6",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19.2.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.1.3",
    "react-email": "5.2.5",
    "reflect-metadata": "^0.2.2",
    "shx": "^0.4.0",
    "socket.io-client": "^4.8.3",
    "superjson": "^2.2.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "ws": "^8.22.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.31.0",
    "@hocuspocus/server": "^3.4.4",
    "@hono/trpc-server": "^0.4.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@octokit/webhooks-methods": "^6.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@polinetwork/auth-kit": "^1.2.0",
    "@react-email/components": "1.0.6",
    "@socket.io/bun-engine": "~0.1.0",
    "@socket.io/devalue-parser": "^0.1.0",
    "@t3-oss/env-core": "^0.13.8",
    "@trpc/server": "11.5.1",
    "croner": "^9.1.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.11.6",
    "nanoid": "^5.1.6",
    "node-html-parser": "^7.0.2",
    "nodemailer": "^7.0.11",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "yjs": "^13.6.33",
    "zod": "^4.1.11"
  }
}
